# Frontend build-time config (Vite bakes these into the client bundle at
# build time -- they are NOT secret: an anon/public Supabase key and a
# publishable Paddle token, safe to ship to a browser). Real values are
# already committed in .env and .env.production for this project; this file
# just documents what they are for anyone standing up a new environment.

VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
VITE_PAYMENTS_CLIENT_TOKEN="your-paddle-client-side-token"

# Everything else FastTract needs is a Supabase Edge Function secret, not a
# frontend env var -- set those with:
#   supabase secrets set --project-ref <ref> NAME=value
# or via the "Deploy Supabase Edge Functions" GitHub Actions workflow, which
# syncs them from repository secrets on every run. See README.md's
# "Production environment variables" table for the full list and what each
# one is for.
